{
	"name": "TitleIcon",
	"private": true,
	"scripts": {
		"test": "grunt test && npm run node-qunit",
		"test-coverage": "grunt test && npm run node-qunit-coverage",
		"node-qunit": "qunit 'tests/node-qunit/**/*.test.js'",
		"node-qunit-coverage": "nyc --reporter=text --reporter=lcovonly --report-dir=coverage/js --all --include='resources/**/*.js' npm run node-qunit"
	},
	"devDependencies": {
		"eslint-config-wikimedia": "0.33.1",
		"grunt": "1.6.3",
		"grunt-banana-checker": "0.13.0",
		"grunt-eslint": "24.3.0",
		"nyc": "18.0.0",
		"qunit": "3.0.0"
	},
	"overrides": {
		"nyc": {
			"glob": "14.0.6",
			"test-exclude": {
				"glob": "14.0.6",
				"minimatch": "11.0.9"
			}
		},
		"@typescript-eslint/typescript-estree": {
			"minimatch": "11.0.9"
		}
	}
}
